{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metadata/CLAIMS.json — claim/assertion nodes (granularity fix; additive to COMPONENT_INDEX.json)",
  "type": "object",
  "required": ["schemaVersion", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "fingerprints", "locations", "provenanceDeclared"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim\\." },
          "type": { "enum": ["fact", "objective", "answer-key", "definition", "derived", "procedure"] },
          "fingerprints": {
            "type": "object",
            "required": ["format", "label", "content", "spine", "provenance"],
            "properties": {
              "format": { "type": "string" }, "label": { "type": "string" },
              "content": { "type": "string" }, "spine": { "type": "string" },
              "provenance": { "type": "string" }
            },
            "additionalProperties": false
          },
          "spineRefs": { "type": "array", "items": { "type": "string" } },
          "sourceRefs": { "type": "array", "items": { "type": "string" } },
          "termRefs": { "type": "array", "items": { "type": "string" } },
          "derivedFrom": { "type": "array", "items": { "type": "string" } },
          "locations": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["file"],
              "properties": { "file": { "type": "string" }, "anchor": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "immutable": { "type": "boolean", "default": false },
          "provenanceDeclared": { "type": "boolean", "description": "true = declared by the generator per contract; false = found by the deterministic scan backstop (indexed + WARN, never hard-fail)" },
          "status": { "enum": ["active", "overridden", "deprecated"], "default": "active" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
