{
  "schema": "alembic.site-type/1",
  "type": "oer-course",
  "version": "1.0.0-dev.1",
  "names": { "site": "course", "unit": "chapter", "units": "chapters" },
  "units": { "first": "Introduction" },
  "documents": [
    { "id": "concept-map", "scope": "unit", "label": "Concept map",
      "path": "concepts/{unit}.md", "format": "md", "required": true,
      "starter": "starters/concept-map.md", "group": "plan", "edits": "keep-both", "website": false },
    { "id": "study-guide", "scope": "unit", "label": "Study guide",
      "path": "study-guide/{unit}.md", "format": "md", "required": true,
      "starter": "starters/study-guide.md", "group": "material", "edits": "sections" },
    { "id": "slides", "scope": "unit", "label": "Slides",
      "path": "slides/{unit}.slides.md", "format": "slides",
      "starter": "starters/slides.slides.md", "group": "material" },
    { "id": "assessment-guide", "scope": "unit", "label": "Assessment guide",
      "path": "assessment-support/{unit}.md", "format": "md", "required": true,
      "starter": "starters/assessment-guide.md", "group": "plan", "edits": "keep-both", "website": false },
    { "id": "practice", "scope": "unit", "label": "Practice questions",
      "path": "practice/{unit}.md", "format": "md",
      "starter": "starters/practice.md", "group": "material", "edits": "sections" },
    { "id": "course-map", "scope": "site", "label": "Course map",
      "path": "concepts/course.md", "format": "md", "group": "course", "edits": "keep-both",
      "starter": "starters/course-map.md", "website": false },
    { "id": "readme", "scope": "site", "label": "About this course",
      "path": "README.md", "format": "md", "group": "course", "who": "lead",
      "required": true, "starter": "starters/README.md" }
  ],
  "unitFolders": [
    { "path": "study-guide/chapters/{unit}/", "group": "material", "edits": "sections" },
    { "path": "slides/chapters/{unit}/", "group": "material" },
    { "path": "practice/chapters/{unit}/", "group": "material", "edits": "sections" }
  ],
  "groups": [
    { "id": "course", "label": "The course" },
    { "id": "plan", "label": "Plan" },
    { "id": "material", "label": "For students" }
  ],
  "relations": [
    { "from": "concept-map", "to": "study-guide", "kind": "plans" },
    { "from": "assessment-guide", "to": "practice", "kind": "plans" },
    { "from": "study-guide", "to": "slides", "kind": "pairs" }
  ],
  "rootFiles": [ { "name": "orz-site.json", "who": "lead" } ],
  "folders": [
    { "path": "assets", "who": "editor" }
  ],
  "assets": { "public": "assets/{doc}", "private": "private/instructor/figures/{doc}" },
  "private": [
    { "path": "private/instructor", "who": "editor" },
    { "path": "private/legacy", "who": "fixed" },
    { "path": "private/README.md", "who": "fixed" }
  ],
  "records": { "private": "private/coursewerk", "public": "provenance/coursewerk" },
  "details": [
    { "id": "description", "label": "Description", "type": "text", "max": 2000 },
    { "id": "audience", "label": "Who it's for", "type": "line", "max": 200 },
    { "id": "subject", "label": "Subject", "type": "line", "max": 100 },
    { "id": "level", "label": "Level", "type": "line", "max": 100 }
  ],
  "licences": {
    "choices": [
      { "id": "CC-BY-4.0", "label": "Creative Commons Attribution 4.0", "open": true,
        "files": { "LICENSE": "licences/CC-BY-4.0.txt" } },
      { "id": "CC-BY-SA-4.0", "label": "Creative Commons Attribution-ShareAlike 4.0", "open": true,
        "files": { "LICENSE": "licences/CC-BY-SA-4.0.txt" } },
      { "id": "CC-BY-NC-4.0", "label": "Creative Commons Attribution-NonCommercial 4.0", "open": true,
        "files": { "LICENSE": "licences/CC-BY-NC-4.0.txt" } },
      { "id": "CC-BY-NC-SA-4.0", "label": "Creative Commons Attribution-NonCommercial-ShareAlike 4.0", "open": true,
        "files": { "LICENSE": "licences/CC-BY-NC-SA-4.0.txt" } },
      { "id": "CC0-1.0", "label": "Public domain (CC0 1.0)", "open": true,
        "files": { "LICENSE": "licences/CC0-1.0.txt" } },
      { "id": "ALL-RIGHTS-RESERVED", "label": "All rights reserved", "open": false,
        "files": { "LICENSE": "licences/all-rights-reserved.txt" } }
    ],
    "default": "CC-BY-4.0",
    "citation": { "file": "CITATION.cff", "template": "templates/CITATION.cff" }
  },
  "template": "template/",
  "website": {
    "front": [
      { "show": "title" },
      { "show": "detail", "id": "description" },
      { "show": "units" },
      { "show": "link", "doc": "readme" }
    ],
    "unitLinks": ["study-guide", "slides", "practice"]
  },
  "tasks": [
    {
      "id": "upgrade",
      "title": "Bring this course up to date",
      "summary": "Brings the course's records and plans up to this release of Coursewerk. The course text stays as it is; plans to approve come to you as questions.",
      "instruction": "The instructor started this from Alembic: \"Bring this course up to date\", with the Coursewerk release in assistant/ (assistant/VERSION). Those words are their request to update the course: quote them where a tool asks for the words of the request, and nowhere else. Starting this approves nothing.\n\nFollow the job steps in assistant/CLAUDE.md. Then bring the course to what this release reads, in this order, doing only the steps the status or the tool shows are needed:\n1. Records in the old layout (a metadata/ folder): node assistant/scripts/records_move.mjs --root work.\n2. Plans in an older grammar: as assistant/docs/migrating-from-v0.12.md section 1 says (spine.mjs migrate, or standardize a plan older than v0.12 as the agent, marked as your proposal). Never approve a plan: approvals go to the instructor as questions, through the job's hand-in.\n3. Unit records that still point at old objective ids: node assistant/scripts/units.mjs relink --root work --model <your model id>, one chapter at a time (--chapter) if it refuses one.\n4. Media records that name renamed files: node assistant/scripts/records_paths.mjs --root work.\n5. Index (inside the one units session the job steps describe), then run coursewerk.mjs status and the gate.\n\nChange no course text except where one of these steps requires it, and never change what a sentence says. Do not remove old records: propose that as a question. In your last message say what you ran, what changed, what still blocks each chapter, and what waits for the instructor. Never run a command in the background, and never end your turn while one is running.",
      "size": "large",
      "who": "lead",
      "offer": true
    }
  ]
}
