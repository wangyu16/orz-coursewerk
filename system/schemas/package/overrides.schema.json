{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metadata/OVERRIDES.json \u2014 instructor override of source (authorized divergence, NOT hallucination)",
  "type": "object",
  "required": [
    "schemaVersion",
    "overrides"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "divergesFrom",
          "basis",
          "authorizedBy",
          "date",
          "rationale"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "pattern": "^claim\\."
          },
          "divergesFrom": {
            "type": "string",
            "description": "the pinned source anchor it deliberately contradicts"
          },
          "basis": {
            "enum": [
              "cited",
              "instructor-expertise",
              "pedagogical-choice"
            ],
            "description": "all three are EQUALLY authoritative inside the package"
          },
          "justifiedBy": {
            "type": "string",
            "description": "required when basis=cited (the newer/authoritative source S')"
          },
          "authorizedBy": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO-8601 date (YYYY-MM-DD). Caller supplies it (no clock inside the pure functions)."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "REQUIRED always; for uncited bases this is the record+explanation for future reference"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "cited"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "justifiedBy"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "justifiedBy"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      },
      "description": "At most ONE active override per claimId (latest-wins-in-place). The audit trail of successive authorizations is NOT lost: OVERRIDES.json is git-versioned, so history is free \u2014 consistent with the project's recency-wins governance model."
    },
    "declinedUpstream": {
      "type": "array",
      "description": "upstream source updates deliberately NOT adopted \u2014 distinguishes 'behind the source' from 'deliberately diverges'",
      "items": {
        "type": "object",
        "required": [
          "sourceRef",
          "date",
          "rationale"
        ],
        "properties": {
          "sourceRef": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
