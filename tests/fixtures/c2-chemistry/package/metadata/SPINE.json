    },
    {
      "id": "concept.chemical-equilibrium.1",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 1,
      "label": "At chemical equilibrium the forward and reverse reactions proceed at equal, nonzero rates, so the reactant and product concentrations no longer change with time.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.2",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 2,
      "label": "Equilibrium is dynamic: individual molecules keep reacting in both directions even though the macroscopic concentrations stay constant.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.3",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 3,
      "label": "For a balanced reaction αA + βB ⇌ σS + τT, the equilibrium constant equals the product concentrations divided by the reactant concentrations, each raised to its stoichiometric coefficient, with the products written in the numerator.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.4",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 4,
      "label": "Pure solids and pure liquids have an activity of one and therefore do not appear in the equilibrium constant expression.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.5",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 5,
      "label": "The reaction quotient has the same form as the equilibrium constant but is evaluated at any composition, and comparing it to the equilibrium constant tells which direction the reaction will shift.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.6",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 6,
      "label": "The equilibrium constant is related to the standard Gibbs energy change of the reaction by ΔG° = −RT ln K.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.7",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 7,
      "label": "The equilibrium constant depends on temperature through the van 't Hoff equation: raising the temperature increases the equilibrium constant for an endothermic reaction and decreases it for an exothermic reaction.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.chemical-equilibrium.8",
      "kind": "concept",
      "scope": "chemical-equilibrium",
      "ordinal": 8,
      "label": "A catalyst speeds up the forward and reverse reactions by the same factor and therefore changes neither the equilibrium constant nor the position of equilibrium.",
      "negative": false,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "concept.course.1",
      "kind": "concept",
      "scope": "course",
      "ordinal": 1,
      "label": "A reversible reaction reaches a dynamic equilibrium where the forward and reverse reactions proceed at equal, nonzero rates.",
      "negative": false,
      "file": "concepts/course.md"
    },
    {
      "id": "concept.course.2",
      "kind": "concept",
      "scope": "course",
      "ordinal": 2,
      "label": "The equilibrium constant quantifies the balance of products to reactants once a reaction has reached equilibrium.",
      "negative": false,
      "file": "concepts/course.md"
    },
    {
      "id": "concept.course.3",
      "kind": "concept",
      "scope": "course",
      "ordinal": 3,
      "label": "Comparing the reaction quotient to the equilibrium constant predicts the direction in which a reaction not yet at equilibrium will move.",
      "negative": false,
      "file": "concepts/course.md"
    },
    {
      "id": "concept.course.4",
      "kind": "concept",
      "scope": "course",
      "ordinal": 4,
      "label": "Le Chatelier's principle predicts qualitatively how an equilibrium already reached shifts to partially counteract a disturbance.",
      "negative": false,
      "file": "concepts/course.md"
    },
    {
      "id": "concept.course.5",
      "kind": "concept",
      "scope": "course",
      "ordinal": 5,
      "label": "A temperature change both shifts the equilibrium position and changes the value of the equilibrium constant, whereas concentration, volume, and pressure changes shift the position without changing the equilibrium constant.",
      "negative": false,
      "file": "concepts/course.md"
    },
    {
      "id": "concept.le-chatelier.1",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 1,
      "label": "Le Chatelier's principle states that a system at equilibrium disturbed by a change in a determining factor adjusts to a new equilibrium that partially counteracts the change.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.2",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 2,
      "label": "Increasing the concentration of a species shifts the equilibrium toward the opposite side to consume the added species, and decreasing it shifts toward that side to replace it.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.3",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 3,
      "label": "A temperature change is handled by treating heat as a product for an exothermic reaction and as a reactant for an endothermic reaction, then applying the same reasoning as for a concentration change.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.4",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 4,
      "label": "A temperature change is unique in that it changes the value of the equilibrium constant, whereas concentration and pressure changes do not.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.5",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 5,
      "label": "For a gas-phase equilibrium, decreasing the volume (raising the pressure) shifts the equilibrium toward the side with fewer moles of gas, and increasing the volume shifts it toward the side with more moles of gas.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.6",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 6,
      "label": "Adding an inert gas at constant volume changes no partial pressure and therefore does not shift a gas-phase equilibrium.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "concept.le-chatelier.7",
      "kind": "concept",
      "scope": "le-chatelier",
      "ordinal": 7,
      "label": "A catalyst speeds up the forward and reverse reactions by the same factor and therefore does not change the position or composition of the equilibrium.",
      "negative": false,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "misconception.chemical-equilibrium.1",
      "kind": "misconception",
      "scope": "chemical-equilibrium",
      "ordinal": 1,
      "label": "At equilibrium the forward and reverse reactions have stopped and nothing is happening at the molecular level.",
      "negative": true,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "misconception.chemical-equilibrium.2",
      "kind": "misconception",
      "scope": "chemical-equilibrium",
      "ordinal": 2,
      "label": "At equilibrium the concentrations of reactants and products are equal to each other.",
      "negative": true,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "misconception.chemical-equilibrium.3",
      "kind": "misconception",
      "scope": "chemical-equilibrium",
      "ordinal": 3,
      "label": "Adding a catalyst shifts the equilibrium toward the products and increases the yield.",
      "negative": true,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "misconception.chemical-equilibrium.4",
      "kind": "misconception",
      "scope": "chemical-equilibrium",
      "ordinal": 4,
      "label": "Adding more of a pure solid or pure liquid changes the value of the equilibrium constant.",
      "negative": true,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "misconception.chemical-equilibrium.5",
      "kind": "misconception",
      "scope": "chemical-equilibrium",
      "ordinal": 5,
      "label": "Changing the concentrations of the species changes the value of the equilibrium constant (rather than only temperature changing it).",
      "negative": true,
      "file": "concepts/chemical-equilibrium.md"
    },
    {
      "id": "misconception.le-chatelier.1",
      "kind": "misconception",
      "scope": "le-chatelier",
      "ordinal": 1,
      "label": "Le Chatelier's principle lets the system completely cancel the disturbance and return to its original equilibrium.",
      "negative": true,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "misconception.le-chatelier.2",
      "kind": "misconception",
      "scope": "le-chatelier",
      "ordinal": 2,
      "label": "Adding a catalyst increases the amount of product present at equilibrium.",
      "negative": true,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "misconception.le-chatelier.3",
      "kind": "misconception",
      "scope": "le-chatelier",
      "ordinal": 3,
      "label": "Adding an inert gas at constant volume shifts a gas-phase equilibrium because the total pressure rises.",
      "negative": true,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "misconception.le-chatelier.4",
      "kind": "misconception",
      "scope": "le-chatelier",
      "ordinal": 4,
      "label": "Raising the temperature always increases the yield of product.",
      "negative": true,
      "file": "concepts/le-chatelier.md"
    },
    {
      "id": "misconception.le-chatelier.5",
      "kind": "misconception",
      "scope": "le-chatelier",
      "ordinal": 5,
      "label": "A pressure change shifts every gas-phase equilibrium, even one with equal moles of gas on both sides.",
      "negative": true,
      "file": "concepts/le-chatelier.md"
    },
    {
